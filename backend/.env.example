# Copy to .env for local development. NEVER commit a real .env.

# development | test | production
NODE_ENV=development

PORT=3000

# EXACT origins allowed to call this API, comma separated.
# "*" is rejected. In production every entry must be https.
# Required in production; defaults to the Angular dev server otherwise.
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# The quiz bank is PostgreSQL-only — there is no file-path config for it.
# Import a bank into DATABASE_URL explicitly with:
#   npm run import:quiz-bank -- --file <path-to-your-quiz-bank.json>

# Postgres connection string for assessment sessions.
#
# REQUIRED in production — the server refuses to boot without it. In
# development it may be omitted, and the server then fails when it first tries
# to connect rather than pretending to be configured.
#
# Neon: use the POOLED string (host contains "-pooler").
# Local: postgres://postgres:postgres@localhost:5432/interviews
DATABASE_URL=


# HMAC key for Topic Quiz attempt receipts.
#
# REQUIRED in production; the server refuses to start without it. Minimum 32
# characters. A weak key would let a client forge its own attempt deadline, and
# an expired receipt authorizes an answer reveal — so this protects the answer
# key, not just session hygiene.
#
# Outside production an omitted value falls back to a clearly-labelled
# development constant, so local runs and tests need no setup.
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
TOPIC_QUIZ_RECEIPT_SECRET=

{
  "name": "quiz-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Private quiz API. Owns the answer key; never serves it as a static file.",
  "license": "MIT",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.js",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "dev": "node --env-file-if-exists=.env --require ts-node/register src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "import:quiz-bank": "node --env-file-if-exists=.env --require ts-node/register scripts/import-quiz-bank.ts",
    "validate:quiz-bank": "node --env-file-if-exists=.env --require ts-node/register scripts/validate-quiz-bank.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.4",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "pg-mem": "^3.0.14",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}

node_modules/
dist/
coverage/

# Real environment values and the SQLite session store are never committed.
.env
*.db
*.db-journal
*.db-wal
*.db-shm

# ── Private quiz bank ───────────────────────────────────────────────
# The real question bank and answer key must never be committed. It lives
# outside this repository and is loaded into PostgreSQL by
# scripts/import-quiz-bank.ts.
#
# Stage 15 removed `data/quiz.json` from the repository entirely — it is no
# longer tracked, and PostgreSQL is the only runtime source. Ignored here too
# (defense in depth) so a re-added copy is never accidentally staged again.
data/quiz.json
private/
*.private.json
quiz-bank.real.json

# Copy to .env for local development. NEVER commit a real .env.

# development | test | production
NODE_ENV=development

PORT=3000

# EXACT origins allowed to call this API, comma separated.
# "*" is rejected. In production every entry must be https.
# Required in production; defaults to the Angular dev server otherwise.
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# The quiz bank is PostgreSQL-only — there is no file-path config for it.
# Import a bank into DATABASE_URL explicitly with:
#   npm run import:quiz-bank -- --file <path-to-your-quiz-bank.json>

# Postgres connection string for assessment sessions.
#
# REQUIRED in production — the server refuses to boot without it. In
# development it may be omitted, and the server then fails when it first tries
# to connect rather than pretending to be configured.
#
# Neon: use the POOLED string (host contains "-pooler").
# Local: postgres://postgres:postgres@localhost:5432/interviews
DATABASE_URL=


# HMAC key for Topic Quiz attempt receipts.
#
# REQUIRED in production; the server refuses to start without it. Minimum 32
# characters. A weak key would let a client forge its own attempt deadline, and
# an expired receipt authorizes an answer reveal — so this protects the answer
# key, not just session hygiene.
#
# Outside production an omitted value falls back to a clearly-labelled
# development constant, so local runs and tests need no setup.
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
TOPIC_QUIZ_RECEIPT_SECRET=


# ── Certificate claims (email-verified certificate issuance) ──────────────
#
# DISABLED unless CERTIFICATE_CLAIMS_ENABLED is exactly "true". Leave every
# variable below blank/unset to leave the feature off — Topic Quiz and
# Interview Mode are completely unaffected either way. See
# docs/certificate-claims-runbook.md for the full design, the real-browser
# test suite, and remaining production setup.
CERTIFICATE_CLAIMS_ENABLED=false

# INDEPENDENT of CERTIFICATE_CLAIMS_ENABLED — gates ONLY GET /certificates/me
# (an existing certificate holder retrieving what they already have).
# Defaults to following CERTIFICATE_CLAIMS_ENABLED (unset here means "same as
# above"), so leaving this blank changes nothing. Set this to "true" while
# CERTIFICATE_CLAIMS_ENABLED=false to keep retrieval working during a
# rollback or an email-provider outage, without re-enabling new submissions,
# resend, verification, or the outbox dispatcher. See
# docs/certificate-claims-runbook.md §7.3.
CERTIFICATE_RETRIEVAL_ENABLED=

EMAIL_FROM_ADDRESS=
OWNER_NOTIFICATION_EMAIL=
# The public Angular origin the emailed verification link points at.
CERTIFICATE_CLAIM_BASE_URL=http://localhost:4200

# AES-256-GCM key for a claimant_verify row's short-lived retry payload.
# Exactly 64 hex characters (32 bytes). Generate with:
#   openssl rand -hex 32
CERTIFICATE_OUTBOX_ENCRYPTION_KEY=

# Which real sender to use — "smtp" or "postmark". REQUIRED in production
# (the server refuses to boot otherwise, rather than silently falling back
# to the in-memory test sender); leave blank in local development to use
# the fake sender instead. Only the variables for whichever provider you
# pick are read at all — selecting "postmark" never requires any
# CERTIFICATE_SMTP_* variable, and vice versa.
#
# WHY TWO PROVIDERS EXIST: the production Node service runs on Render's
# free tier, which blocks outbound SMTP ports (25/465/587) entirely but
# allows ordinary outbound HTTPS — see docs/certificate-claims-runbook.md.
# Postmark is therefore the one that can actually work in production today
# without a Render plan upgrade; SMTP is kept for optional/local use, or
# for if the plan is upgraded later.
CERTIFICATE_EMAIL_PROVIDER=

# ── Option A: SMTP (Nodemailer — see src/certificate/smtp-email-
#    sender.ts). All FIVE are required together once CERTIFICATE_EMAIL_
#    PROVIDER=smtp (a partial set is always treated as a mistake).
#
# ENTER CERTIFICATE_SMTP_PASSWORD ONLY IN YOUR OWN LOCAL backend/.env FILE
# (already gitignored — never commit it). Do not paste the real password
# into chat, a commit message, a log, or this example file.
CERTIFICATE_SMTP_HOST=
# Preferred: 587 with CERTIFICATE_SMTP_TLS_MODE=starttls (mandatory
# STARTTLS upgrade). Implicit TLS (typically port 465) is also supported —
# set CERTIFICATE_SMTP_TLS_MODE=tls for that instead. There is no insecure
# option; certificate validation is always on and is not configurable here.
CERTIFICATE_SMTP_PORT=587
CERTIFICATE_SMTP_TLS_MODE=starttls
CERTIFICATE_SMTP_USERNAME=
CERTIFICATE_SMTP_PASSWORD=

# ── Option B: Postmark HTTP Email API (see src/certificate/postmark-
#    email-sender.ts). Use a SERVER token from the Postmark dashboard —
#    never an account token (the two are distinct and have different
#    privileges). MessageStream defaults to "outbound" (Postmark's own
#    default transactional stream) if left blank.
#
# ENTER CERTIFICATE_POSTMARK_SERVER_TOKEN ONLY IN YOUR OWN LOCAL
# backend/.env FILE (already gitignored — never commit it). Do not paste
# the real token into chat, a commit message, a log, or this example file.
CERTIFICATE_POSTMARK_SERVER_TOKEN=
CERTIFICATE_POSTMARK_MESSAGE_STREAM=outbound

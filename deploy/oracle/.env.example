# Copy this file to `.env` next to compose.yaml and fill in real values —
# `.env` itself is gitignored (see the repository-root .gitignore's `.env`
# entry, which also covers this nested path) and must NEVER be committed.
#
# Every placeholder below is exactly that: a placeholder. Nothing in this
# file is a real hostname, credential, or secret.
#
# ─────────────────────────────────────────────────────────────────────────
# ORACLE / DEPLOYMENT variables — control how and where this compose
# project runs. None of these are read by the Spring application itself.
# ─────────────────────────────────────────────────────────────────────────

# The public hostname Caddy issues its HTTPS certificate for and listens
# on. This is the REAL, live DNS name — interview-api-spring
# .marvinrusinek.com already resolves to the Oracle VM's reserved public
# IP (docs/oracle-migration-runbook.md's provisioned-VM facts). Live DNS
# is a prerequisite for Caddy's automatic HTTPS, not itself a production
# traffic cutover — Angular keeps pointing at Render until the runbook's
# full staged validation is complete.
SPRING_API_DOMAIN=interview-api-spring.marvinrusinek.com

# Image tag compose.yaml builds/runs. DELIBERATELY NOT left at a floating
# tag like "latest" — deploy.sh derives an immutable tag automatically
# (the current git commit's short SHA) if this is left unset, so each
# deploy is traceable to an exact commit and scripts/rollback.sh always
# has a concrete, unambiguous previous tag to restore. Leave this UNSET
# to get that automatic behavior; only set it explicitly to pin a
# specific, different build.
SPRING_IMAGE_TAG=

# ─────────────────────────────────────────────────────────────────────────
# SPRING APPLICATION variables — the SAME names, same meaning, same
# fail-closed requirement as the existing Render deployment (see
# backend-spring/src/main/resources/application.properties and
# render.yaml). Moving hosting target does not change what the app itself
# needs; only where these values come from.
# ─────────────────────────────────────────────────────────────────────────

# Clean JDBC URL only — scheme, host, port, database, and query params,
# with NO embedded username/password. Use Neon's POOLED endpoint (host
# contains "-pooler") with ?sslmode=require appended, exactly as the
# existing Render deployment already does — see application.properties'
# own SSL comment for why sslmode=require (not disable, not verify-full)
# is the correct posture here.
#   Example SHAPE only, not a real host:
#   jdbc:postgresql://REPLACE-WITH-NEON-POOLED-HOST/REPLACE-WITH-DB?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://REPLACE_ME_HOST/REPLACE_ME_DB?sslmode=require

# Credentials go here, separate from the URL above — Spring's own
# DataSourceProperties/Hikari expect them this way. Use the SAME Neon
# database credentials the Render deployment already uses; this is a
# hosting-target change, not a database or credential change.
SPRING_DATASOURCE_USERNAME=REPLACE_ME_USERNAME
SPRING_DATASOURCE_PASSWORD=REPLACE_ME_PASSWORD

# HMAC signing secret for Topic Quiz attempt/question receipts. MUST be the
# EXACT SAME VALUE Node's TOPIC_QUIZ_RECEIPT_SECRET already holds — not a
# distinct per-deployment secret; a receipt issued by one runtime must
# verify on the other. At least 32 characters (the app refuses to start
# otherwise).
TOPIC_QUIZ_RECEIPT_SECRET=REPLACE_ME_MIN_32_CHARS

# Comma-separated exact origins this API accepts requests from. OPTIONAL —
# Spring's own default (application.properties:
# cors.allowed-origins=${ALLOWED_ORIGINS:}) is an empty, safely-restrictive
# allow-list if this is left unset entirely; compose.yaml does not require
# it either (unlike the datasource/receipt-secret variables above, which
# ARE hard-required). Structurally rejects a literal "*" at startup
# regardless of environment (see AllowedOrigins.java) — this cannot be
# loosened to a wildcard by accident.
#
# During Stage C/D of the migration (Oracle deployed but Angular production
# still points at Render), this can stay EMPTY or scoped to a throwaway
# test origin only. At Stage E's actual cutover, set it to the real
# production frontend origin — the SAME value Node's own ALLOWED_ORIGINS
# and Spring's current Render deployment already use:
#   ALLOWED_ORIGINS=https://marvinrusinek.github.io
ALLOWED_ORIGINS=

# PORT is deliberately absent here: compose.yaml never publishes Spring's
# port to the host at all (Caddy reaches it over the internal Docker
# network by service name), so there is nothing for Render's own
# "PaaS injects PORT" behavior to replace — the app keeps its
# server.port=${PORT:8080} local-dev default.
